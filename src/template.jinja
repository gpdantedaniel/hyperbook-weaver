
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Hyperbook Graph Visualization</title>
  <script src="https://d3js.org/d3.v6.min.js"></script>
  <style>
    svg {
      font: 10px sans-serif;
    }
    .link {
      stroke: #eee; /* Light gray for visibility */
      stroke-opacity: 0.6;
    }
    .node circle {
      stroke: #fff;
      stroke-width: 1.5px;
    }

    .nodes {
      cursor: grab
    }

    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      width: 100%;
      overflow: hidden;
    }
    svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    body, svg {
      background-color: black !important;
    }
    text {
      fill: white !important;
    }
  </style>
</head>
<body>
  <svg id="graphSvg">
    <!-- GLOW FILTER -->
    <defs>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3.5" result="coloredBlur"/>
        <feComposite in="coloredBlur" in2="SourceAlpha" operator="in" result="softGlow"/>
        <feMerge>
          <feMergeNode in="softGlow"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
  </svg>
  <script>

      function wrap(textSelection, width) {
        textSelection.each(function() {
          const text = d3.select(this);
          const words = text.text().split(/\s+/).reverse();
          let line = [], lineNumber = 0;
          const lineHeight = 1.1; // ems
          const x = text.attr("x") || 0;
          const y = text.attr("y") || 0;
          let tspan = text.text(null).append("tspan").attr("x", x).attr("y", y);

          while (words.length) {
            line.push(words.pop());
            tspan.text(line.join(" "));
            if (tspan.node().getComputedTextLength() > width) {
              line.pop();
              tspan.text(line.join(" "));
              line = [words.pop()];
              tspan = text.append("tspan")
                .attr("x", x)
                .attr("y", y)
                .attr("dy", ++lineNumber * lineHeight + "em")
                .text(line.join(" "));
            }
          }
        });
      }

      const raw = {{ data | tojson }};

      const graph = {
        nodes: raw.nodes,
        links: raw.edges.map(e => ({source: e.from, target: e.to}))
      };

      const linkedById = {};
      graph.links.forEach(l => {
        linkedById[`${l.source},${l.target}`] = true;
        linkedById[`${l.target},${l.source}`] = true;
      });

      // Compute degree (number of links per node)
      const nodeDegree = {};
      graph.nodes.forEach(n => nodeDegree[n.id] = 0);
      graph.links.forEach(link => {
        nodeDegree[link.source] += 1;
        nodeDegree[link.target] += 1;
      });

      function isNeighbor(a, b) {
        return linkedById[`${a.id},${b.id}`];
      }

      const svg = d3.select('[id="graphSvg"]');

      console.log(svg);
      const width = window.innerWidth, height = window.innerHeight;

      // Zoom/pan group
      const zoom = d3.zoom()
        .scaleExtent([0.1, 10])
        .on("zoom", evt => g.attr("transform", evt.transform));
      svg.call(zoom);
      const g = svg.append("g");

      const color = d3.scaleOrdinal()
        .domain(["cluster","article"])
        .range(["#1f77b4","#ff7f0e"]);

      const link = g.append("g").selectAll("line")
        .data(graph.links).join("line")
        .attr("class","link").attr("stroke-width",1);

      const node = g.append("g")
        .selectAll("g")
        .attr("class", "nodes")
        .data(graph.nodes).join("g")
        .call(d3.drag()
          .on("start", dragstarted)
          .on("drag", dragged)
          .on("end", dragended));

      node.append("circle")
        .attr("r", d => 5 + nodeDegree[d.id] || 1) // Adjust scale here
        .attr("fill", d => color(d.type))
        .attr("stroke", "white") // Add white border
        .attr("filter", "url(#glow)"); // Apply glow effect

      const labels = node.append("text")
        .attr("text-anchor", "start")
        .attr("x", 10)
        .attr("y", -5) // Adjust to position above or beside the circle
        .attr("font-size", "10px")
        .text(d => d.label)

      // Force simulation
      const simulation = d3.forceSimulation(graph.nodes)
        .force("link", d3.forceLink(graph.links).id(d => d.id).distance(50))
        .force("charge", d3.forceManyBody().strength(-400))
        .force("center", d3.forceCenter(width/2, height/2))
        .on("tick", ticked);

      function ticked() {
        link
          .attr("x1", d=>d.source.x).attr("y1", d=>d.source.y)
          .attr("x2", d=>d.target.x).attr("y2", d=>d.target.y);

        node.attr("transform", d=>`translate(${d.x},${d.y})`);
      }

      function dragstarted(event, d) {
        // simulate mousedown highlight
        node.style("opacity", o =>
          (o.id === d.id || isNeighbor(d, o)) ? 1 : 0.2
        );
        link.style("stroke-opacity", l =>
          (l.source.id === d.id || l.target.id === d.id) ? 1 : 0.05
        );
        
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x; d.fy = d.y;
      }
      function dragged(event, d) {
        d.fx = event.x; d.fy = event.y;
      }
      function dragended(event, d) {
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null; d.fy = null;

        // reset all opacities
        node.style("opacity", 1);
        link.style("stroke-opacity", 0.6);
      }

      // Update sizes on resize
      window.addEventListener("resize", () => {
        const w = window.innerWidth, h = window.innerHeight;
        svg.attr("width", w).attr("height", h);
        simulation.force("center", d3.forceCenter(w/2, h/2)).alpha(0.3).restart();
      });

      // toggle highlight state
      let highlightActive = false;
  </script>
</body>
</html>